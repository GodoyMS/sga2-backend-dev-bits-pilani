# --- Gateway ---
PORT=8080
# Comma-separated list of valid API keys (sent as the x-api-key header)
API_KEYS=demo-fleet-key
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Shared secret for service-to-service calls (never exposed through the gateway)
SERVICE_TOKEN=change-me-too

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fleet
DATABASE_SSL=false

# --- Geolocation (Google Maps if a key is set, otherwise OpenStreetMap Nominatim) ---
GOOGLE_MAPS_API_KEY=
# GEOCODER_PROVIDER=google|nominatim
GEOCODER_USER_AGENT=FleetManagementSystem/1.0 (your-email@example.com)

# --- SMS (Twilio if credentials are set, otherwise a local stub) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# Extra E.164 numbers that receive every alert (comma-separated)
ALERT_PHONE_NUMBERS=
# SMS_PROVIDER=twilio|stub

# --- Demo data ---
SEED_DEMO_DATA=true
SEED_ADMIN_PASSWORD=Admin@123
# Phone of the seeded admin (E.164). On a Twilio trial this must be a verified number.
SEED_ADMIN_PHONE=

# Used only when a Twilio trial account rejects custom text (error 572006)
TWILIO_TRIAL_TEMPLATE=sms_delivery_updates
