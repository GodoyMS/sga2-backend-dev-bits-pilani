{
  "name": "fleet-management-system",
  "version": "1.0.0",
  "description": "Fleet Management System backend: API Gateway, user/vehicle/telemetry/geolocation/notification services, Google Maps / OpenStreetMap geocoding, Twilio SMS, Swagger docs and Mocha/Chai tests.",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "mocha",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:memory": "ts-node --transpile-only scripts/dev-in-memory.ts"
  },
  "keywords": [
    "fleet",
    "api-gateway",
    "express",
    "geolocation",
    "twilio",
    "swagger"
  ],
  "author": "Godoy Muñoz",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "http-proxy-middleware": "^3.0.10",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "1.9",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.3.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/sinon": "^22.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "pg-mem": "^3.0.14",
    "sinon": "^22.1.0",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
